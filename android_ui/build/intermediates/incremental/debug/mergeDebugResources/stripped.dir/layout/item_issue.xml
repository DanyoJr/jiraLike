<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="4dp"
    app:cardBackgroundColor="@color/windowBackground"
    app:cardCornerRadius="4dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/issueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Parent group's Tarefa's Titulo"
            android:textColor="@color/textColorPrimary"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prazo: "
                android:textColor="@color/textColorPrimary"
                android:textStyle="bold"
                android:textSize="10sp"/>
            <TextView
                android:id="@+id/issueDueDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parent group's Tarefa's Prazo:formatted"
                android:textColor="@color/textColorPrimary"
                android:textSize="10sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Responsável: "
                android:textColor="@color/textColorPrimary"
                android:textStyle="bold"
                android:textSize="10sp"/>
            <TextView
                android:id="@+id/issueAssignee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parent group's Tarefa's Responsavel's Nome completo"
                android:textColor="@color/textColorPrimary"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- Apenas botões pequenos para mover de coluna no Mobile (já que não temos Drag and Drop nativo ainda) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/btnMoveBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Mover"
                android:textColor="#3B82F6"
                android:textSize="12sp"
                android:layout_marginEnd="16dp"
                android:padding="4dp"/>
            <TextView
                android:id="@+id/btnMoveForward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mover →"
                android:textColor="#3B82F6"
                android:textSize="12sp"
                android:padding="4dp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
